# Google AI Studio key for the AI health assistant.
# Create one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
VITE_GEMINI_MODEL=

# Optional. 0 to 1. Forces a share of mock data requests to fail so the
# error states can be demonstrated. Defaults to 0.
VITE_MOCK_FAILURE_RATE=
